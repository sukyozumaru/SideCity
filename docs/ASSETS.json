      "variants": [
        "parcel mark",
        "map",
        "grid",
        "fit",
        "home",
        "north"
      ],
      "collision": "none"
    },
    {
      "id": "founders",
      "source": "src/renderer.js: drawPerson",
      "variants": [
        "Ana",
        "Ivo",
        "Nara"
      ],
      "anchor": "feet on logical parcel",
      "animation": [
        "walk",
        "work"
      ],
      "collision": "land paths"
    },
    {
